{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "fallbackModel": [
    "claude-opus-5"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/claude-vault/sync.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/claude-vault/sync-on-write.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
